# TIMPORYE — szablon konfiguracji (skopiuj do .env i uzupełnij).
# Backend czyta te zmienne przez pydantic-settings (backend/app/config.py, klasa Settings).
# Wartości poniżej = domyślne z kodu albo bezpieczne atrapy; ŻADNYCH prawdziwych sekretów w repo.
# Pełny katalog z opisem: docs/ZMIENNE-SRODOWISKOWE.md. Kompletność pilnuje
# backend/tests/test_env_example.py (nowe pole Settings = nowa linia tutaj).
# Docker: compose przekazuje do kontenera TYLKO zmienne z listy `environment:` w
# docker-compose*.yml — zmienna spoza tej listy działa lokalnie, ale nie w kontenerze.

# --- Rdzeń i baza ---
# nazwa w tytule API i domyślna nazwa w nagłówku portalu klienta
APP_NAME=TIMPORYE — kolejka kontenerów
# dev / production — w production aplikacja NIE wystartuje z domyślnymi sekretami
ENVIRONMENT=dev
# Baza danych: SQLite (dev) lub PostgreSQL (produkcja / docker-compose)
DATABASE_URL=sqlite:///./timporye.db
#DATABASE_URL=postgresql+psycopg2://timporye:HASLO@db:5432/timporye
# hasło bazy dla docker-compose (poza Settings: compose składa z niego DATABASE_URL)
POSTGRES_PASSWORD=zmien-mnie
# pula połączeń PostgreSQL: rozmiar, nadmiar, czekanie na wolne (s), recykling (s)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# false = instancja wtórna na wspólnej bazie: bez pętli tła (alerty, SMS-y, AIS)
RUN_BACKGROUND_JOBS=true
# BUILD-003: workery uvicorna (1–16; >1 tylko PostgreSQL, pętle tła prowadzi jeden lider;
# budżet: workery × (DB_POOL_SIZE + DB_MAX_OVERFLOW + 2) < max_connections) — docs/JEDNA-INSTANCJA.md
WEB_CONCURRENCY=1
# ścieżka builda panelu; puste = ../frontend/dist względem backendu
FRONTEND_DIST=

# --- Sekrety i konto startowe ---
# Sekret JWT i szyfrowania — wygeneruj: python -c "import secrets; print(secrets.token_hex(32))"
# W produkcji WYMAGANE min. 32 znaki (inaczej aplikacja nie wystartuje).
SECRET_KEY=change-me-in-production
# Osobny klucz szyfrowania danych w bazie (cache Power BI; SEC-017) — w produkcji zalecany:
# rotacja SECRET_KEY nie psuje wtedy zaszyfrowanych danych; puste = klucz z SECRET_KEY
DATA_ENCRYPTION_KEY=
# konto administratora tworzone przy pierwszym starcie (w production hasło musi być zmienione)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
# true = admin musi włączyć 2FA przy logowaniu (do tego czasu tylko odczyt); domyślnie wyłączone
REQUIRE_2FA_ADMIN=false

# --- Sesje, logowanie, limity ---
# ważność tokenu dostępu (min; decyzja 2026-09-18: 2 h) i refresh tokenu (dni)
ACCESS_TOKEN_MINUTES=120
REFRESH_TOKEN_DAYS=14
# okno łaski (s) na ponowne użycie zrotowanego refresh tokenu (wyścig kart); w oknie tylko nowy access (SEC-010)
REFRESH_REUSE_GRACE_SECONDS=10
# brute force: limit porażek na parę IP+login w oknie (min) i łączny limit na IP
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_ATTEMPTS_PER_IP=20
# SEC-012: porażki jednego konta ze wszystkich IP, od których rośnie przerwa (s, ×2 za każdą)
LOGIN_ACCOUNT_LOCK_AFTER=10
LOGIN_ACCOUNT_LOCK_SECONDS=30
# globalny limit żądań API na IP w oknie minutowym (0 = wyłączony; per instancja)
API_RATE_LIMIT_PER_MINUTE=300
# ważność linku resetu hasła (min) i minimalna długość hasła
PASSWORD_RESET_MINUTES=30
PASSWORD_MIN_LENGTH=12
# koszt bcrypt hashy haseł (2^N rund); produkcja min. 12 — niżej start odmawia (4 tylko w testach)
BCRYPT_ROUNDS=12
# limit beaconów błędów JS z panelu (na IP, na minutę)
CLIENT_ERROR_RATE_PER_MINUTE=10

# --- HTTPS, proxy, adresy ---
# true za HTTPS — cookies dostają flagę Secure, dochodzi nagłówek HSTS
SECURE_COOKIES=false
# production po HTTP (serwer przed certyfikatem): zwalnia TYLKO wymóg SECURE_COOKIES
ALLOW_INSECURE_HTTP=false
# publiczny adres panelu w linkach e-mail — w produkcji WYMAGANY (ochrona przed host-header injection)
PUBLIC_BASE_URL=
# dozwolone nagłówki Host (CSV), np. kolejka.twojafirma.pl; puste = bez filtra
ALLOWED_HOSTS=
# CORS: puste = wyłączony (panel z tego samego adresu); lista originów po przecinku
CORS_ORIGINS=
# ile zaufanych proxy przed aplikacją (Coolify/Traefik = 1, z bramą nginx = 2)
TRUSTED_PROXY_COUNT=1
# sieci (CIDR, CSV), od których honorujemy X-Forwarded-For — tylko sieć dockera proxy
TRUSTED_PROXY_CIDRS=172.16.0.0/12,127.0.0.1/32

# --- Branding i instancja pokazowa ---
# nazwa i logo w nagłówku stron publicznych (portal klienta); puste nazwa = APP_NAME
PORTAL_BRAND_NAME=
PORTAL_LOGO_URL=
# loginy tylko do odczytu (CSV) i podpowiedź na ekranie logowania — tylko instancja demo
DEMO_READONLY_LOGINS=
DEMO_LOGIN_HINT=

# --- Pliki, kopie, logi ---
# katalog załączników, limit rozmiaru (MB) i dozwolone rozszerzenia
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_EXTENSIONS=pdf,doc,docx,xls,xlsx,csv,txt,png,jpg,jpeg,webp,gif,eml,msg,zip,xml,json
# katalog kopii bazy (backend/scripts/backup.sh) — patrz docs/BACKUPY.md
BACKUP_DIR=/data/backups
# ile najnowszych kopii zostawia backup.sh (poza Settings — czyta go skrypt)
BACKUP_KEEP=14
# najstarsza akceptowana kopia (h) i dzień cotygodniowej weryfikacji (0=pon … 6=niedz)
BACKUP_MAX_AGE_HOURS=194
VERIFY_BACKUP_WEEKDAY=6
# trwały plik logów z rotacją, np. /data/logs/app.log; puste = tylko stdout
LOG_FILE=
# /proc hosta (read-only) dla monitora procesów w panelu; brak = sam kontener
HOST_PROC_DIR=/host/proc

# --- Retencja danych (RODO, dni) ---
TOKEN_RETENTION_DAYS=30
SMS_RETENTION_DAYS=90
CLIENT_ERROR_RETENTION_DAYS=30
DRIVER_DATA_RETENTION_DAYS=90
AUDIT_AUTH_RETENTION_DAYS=90
NOTIFICATION_RETENTION_DAYS=90

# --- Monitoring błędów (Sentry) ---
# DSN projektu Sentry (puste = wyłączony) i znacznik wydania (SHA/tag builda)
SENTRY_DSN=
SENTRY_RELEASE=
# odsetek transakcji (wydajność) wysyłanych do Sentry, 0–1; błędy idą zawsze wszystkie
SENTRY_TRACES_RATE=0.05

# --- Poczta i powiadomienia ---
# główny SMTP (puste SMTP_HOST = e-maile wyłączone)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=timporye@localhost
# osobny SMTP tylko dla zaproszeń użytkowników; puste = główny SMTP
INVITE_SMTP_HOST=
INVITE_SMTP_PORT=587
INVITE_SMTP_USER=
INVITE_SMTP_PASSWORD=
INVITE_SMTP_FROM=
# maile awizacji do spedycji: graph / smtp / console; puste = smtp przy SMTP_HOST, inaczej console
MAIL_BACKEND=
# Microsoft Graph (M365, client credentials) dla MAIL_BACKEND=graph + skrzynka nadawcy
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MAIL_SENDER=
# webhook kanału Teams (puste = wyłączone) i godzina porannego digestu (czas PL)
TEAMS_WEBHOOK_URL=
DIGEST_HOUR=7

# --- SMS do kierowców i linki publiczne ---
# dostawca SMS: smsapi / mock / off
SMS_PROVIDER=off
SMSAPI_TOKEN=
SMSAPI_URL=https://api.smsapi.pl/sms.do
# COST-003: limit prób SMS na dobę (czas PL, 0 = bez limitu; alert adminów przy 80% i 100%)
# i prób auto-przypomnienia na kontener+datę dostawy w dobie
SMS_DAILY_CAP=200
SMS_AUTO_MAX_ATTEMPTS=2
# ważność linku kierowcy bez daty dostawy (dni) i nowego linku portalu klienta (0 = bez własnego terminu)
# SEC-014: twardy limit każdego publicznego linku (kontener, portal, DLT, kierowca) od wystawienia (dni)
PUBLIC_LINK_MAX_DAYS=90
# ważność linków awizacji: etap 1 (dostawy) i etap 2 (kierowcy), w dniach
AVIZO_STAGE1_DAYS=7
AVIZO_STAGE2_DAYS=5

# --- Tracking i AIS ---
# interwał zadania kongestii portów (h) i próg alertu o zmianie ETA (dni)
TRACKING_INTERVAL_HOURS=12
TRACKING_ETA_ALERT_DAYS=2
# klucz aisstream.io — pusty = kolektor pozycji statków wyłączony
AISSTREAM_API_KEY=
AISSTREAM_URL=wss://stream.aisstream.io/v0/stream
# odnowienie subskrypcji (s), przerwa po błędzie (s), alert postoju (h), „zamrożony” statek (h)
AIS_RESUBSCRIBE_SECONDS=900
AIS_ERROR_BACKOFF_SECONDS=60
AIS_ANCHOR_ALERT_HOURS=48
AIS_STALE_HOURS=24

# --- Progi alertów biznesowych ---
# demurrage: alert N dni przed końcem free time; domyślne free days, gdy puste w kontenerze
DEMURRAGE_ALERT_DAYS=3
DEMURRAGE_DEFAULT_FREE_DAYS=5
# alert, gdy odprawa trwa dłużej niż N dni od zlecenia
CUSTOMS_ALERT_DAYS=3
# alert „stęchły import” master data po N dniach
STALE_IMPORT_DAYS=14
# reklamacje: auto-szkic N dni po ETA, terminy przedawnienia per adresat, alert przed terminem
COMPLAINT_AUTO_DRAFT_DAYS=7
COMPLAINT_DEADLINE_CARRIER_DAYS=14
COMPLAINT_DEADLINE_INSURER_DAYS=60
COMPLAINT_DEADLINE_SUPPLIER_DAYS=30
COMPLAINT_DEADLINE_ALERT_DAYS=3

# --- Dokumenty, faktury, kartoteka dostawców ---
# limit stron PDF faktury, horyzont alertu braków dokumentów (dni), tolerancja faktura↔zamówienie (%)
INVOICE_PDF_MAX_PAGES=60
DOCS_ETA_DAYS=5
INVOICE_TOLERANCE_PCT=2.0
# kody spółek (CSV) pracujących na globalnej kartotece dostawców
SUPPLIER_COMPANY_CODES=ACME,PT
# twardy limit plików w masowym ZIP miesiąca
ARCHIVE_ZIP_MAX_FILES=500

# --- OCR, lokalny LLM (Ollama), ML ---
# OCR skanów (Tesseract): włącznik, języki, rozdzielczość renderu
OCR_ENABLED=true
OCR_LANG=pol+eng
OCR_DPI=220
# faktury: cięcie/OCR/ekstrakcja w pętli tła (upload → 202); false = w żądaniu HTTP (ARCH-004)
INVOICE_OCR_IN_BACKGROUND=true
# adres Ollamy na własnym serwerze — pusty = AI wyłączone (dane nie wychodzą poza serwer)
OLLAMA_URL=
# true = świadoma zgoda na Ollamę spoza sieci Dockera/firmowej (domyślnie adres publiczny = AI wyłączone)
OLLAMA_ALLOW_REMOTE=false
OLLAMA_TIMEOUT=300
# modele: OCR obrazowy i asystent wiedzy
OCR_VISION_MODEL=qwen2.5vl:3b
ASSISTANT_MODEL=qwen2.5:1.5b
# równoległe wywołania LLM, czekanie na slot (s), timeout asystenta (s), limit pytań/min na osobę
LLM_MAX_CONCURRENCY=1
LLM_WAIT_S=2.0
LLM_TIMEOUT_S=120
ASSISTANT_RATE_LIMIT_PER_MINUTE=10
# katalog modeli ML (puste = katalog ml OBOK UPLOADS_DIR, np. /data/ml — AI-007), progi pewności, min. przykładów, dotrenowanie
ML_MODEL_DIR=
ML_AUTO_APPLY_THRESHOLD=0.9
ML_DOCKIND_THRESHOLD=0.8
ML_MIN_EXAMPLES=20
ML_AUTO_TRAIN=true

# --- Serwis paletyzacji (opcjonalny) ---
# API serwisu paletyzacji (X-API-Key); puste = sekcja paletyzacji pokazuje „nie skonfigurowany”
PALLET_API_URL=
PALLET_API_TOKEN=
PALLET_API_TIMEOUT=5.0

# --- SharePoint → sync kolejki (docs/SHAREPOINT-SYNC.md) ---
# aplikacja Graph (Sites.Selected read); wszystkie pola puste = sync wyłączony
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
# witryna, ścieżka pliku kolejki i kod spółki (Company.code), do której trafia kolejka
SHAREPOINT_SITE=
SHAREPOINT_QUEUE_PATH=
SHAREPOINT_QUEUE_COMPANY=
# automat co N minut tylko przy SHAREPOINT_AUTO_SYNC=true (domyślnie ręcznie z panelu)
SHAREPOINT_QUEUE_INTERVAL_MINUTES=15
SHAREPOINT_AUTO_SYNC=false

# --- Automatyzacje (n8n, docs/N8N.md) ---
# Token serwisowy (nagłówek X-Automation-Token). PUSTY = integracja WYŁĄCZONA.
# Wygeneruj: python -c "import secrets; print(secrets.token_urlsafe(32))" — w produkcji min. 32 znaki.
AUTOMATION_API_TOKEN=
# ACL-005: poprzedni token akceptowany w czasie rotacji (docs/N8N.md §4; po przełączeniu n8n wyczyść),
# opcjonalny termin ważności tokenu RRRR-MM-DD i sieci CSV (CIDR), z których wolno go użyć
AUTOMATION_API_TOKEN_PREVIOUS=
AUTOMATION_TOKEN_EXPIRES=
AUTOMATION_ALLOWED_CIDRS=
# login konta, którego rolą działa n8n i na które podpisuje się audyt (rola admin odrzucana)
AUTOMATION_ACTOR_LOGIN=n8n
# Production URL webhooka n8n dla zdarzeń z aplikacji (puste = wyłączone; to NIE N8N_WEBHOOK_URL)
AUTOMATION_WEBHOOK_URL=
# sekret podpisu HMAC-SHA256 ciała (nagłówek X-Timporye-Signature); puste = bez podpisu
AUTOMATION_WEBHOOK_SECRET=

# --- Wywołania DLT / Power BI (SAP BW) ---
# źródło danych: off / mock / real
POWERBI_PROVIDER=off
# workspace i pary dataset/tabela dla stanów, VBBA, zleceń i zużycia
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_STOCK=
POWERBI_TABLE_STOCK=
POWERBI_DATASET_VBBA=
POWERBI_TABLE_VBBA=
POWERBI_DATASET_ORDERS=
POWERBI_TABLE_ORDERS=
POWERBI_DATASET_USAGE=
POWERBI_TABLE_USAGE=
# kolumna łączenia źródeł i statusy otwartych pozycji VBBA (CSV)
POWERBI_MERGE_KEY=produkt
VBBA_OPEN_STATUSES=Nie rozpoczęte,Częściowo zakończone
# kolumny ilości potwierdzonej/niepotwierdzonej w zleceniach sprzedaży
POWERBI_ORDERS_CONFIRMED_FIELD=potw
POWERBI_ORDERS_UNCONFIRMED_FIELD=niestandardowe
# kolumna lokalizacji i wartości/prefiksy oznaczające DLT (CSV; reszta = magazyn)
POWERBI_LOCATION_FIELD=miejsce_skladowania
POWERBI_DLT_LOCATIONS=
# aplikacja Azure AD (client credentials) albo wklejony token (tylko dev)
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_ACCESS_TOKEN=
# TLS: własny CA bundle (proxy re-sygnujące) i weryfikacja (false tylko w dev)
POWERBI_CA_BUNDLE=
POWERBI_SSL_VERIFY=true
# cache odpowiedzi (min) i remap kolumn JSON {nasza_nazwa: nazwa_w_kostce}
POWERBI_CACHE_TTL_MIN=15
POWERBI_COLUMN_MAP=
# adresat wywołań palet i lista adresów DLT (CSV) na wypadek magazynu bez e-maila
DLT_EMAIL=
DLT_CALL_EMAILS=
# kalibracja palet: docelowy zapas (dni), próg „pilne”, cykl alertów (h), horyzont prognozy (dni)
PALLET_TARGET_DAYS=14
PALLET_URGENT_THRESHOLD=2.0
PALLET_ALERT_INTERVAL_HOURS=12
PALLET_FORECAST_HORIZON_DAYS=14
# obsada rozładunków: ile palet rozładowuje jedna osoba na zmianę
STAFFING_PALLETS_PER_PERSON=40
